{
  "name": "@mr-darcy/api",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "5.9"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "npm run build && typeorm migration:generate -d dist/database/data-source.js",
    "db:migrate": "npm run build && typeorm migration:run -d dist/database/data-source.js --transaction all",
    "db:status": "npm run build && typeorm migration:show -d dist/database/data-source.js",
    "db:seed": "npm run build && node dist/database/seed.js"
  }
}
