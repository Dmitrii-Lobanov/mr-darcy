{
  "name": "@mr-darcy/api",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "typescript": "5.9"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others \"tsc --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  }
}
