{
  "name": "mr-darcy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps/api/src apps/web --max-warnings 0",
    "lint:fix": "eslint apps/api/src apps/web --fix --max-warnings 0",
    "api:contract": "openapi-typescript http://127.0.0.1:3001/api/docs-json -o packages/api-contract/generated/schema.d.ts",
    "api:contract:check": "npm run api:contract -- --check",
    "test:e2e": "npm run build --workspace @mr-darcy/api && npm run build --workspace @mr-darcy/web && playwright test"
  }
}
